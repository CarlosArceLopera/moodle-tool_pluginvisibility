{{!
    @template tool_pluginvisibility/instructions

    Instructions for plugin visibility management page.

    Context variables required for this template:
    * categoryname - The name of the category

    Example context (json):
    {
        "categoryname": "Test Category"
    }
}}
<div class="alert alert-info">
    <h4 class="alert-heading">{{#str}}instructions_heading, tool_pluginvisibility{{/str}}</h4>
    <p>{{#str}}instructions_text, tool_pluginvisibility, {{categoryname}}{{/str}}</p>
    <ul>
        <li>{{#str}}instructions_bullet1, tool_pluginvisibility{{/str}}</li>
        <li>{{#str}}instructions_bullet2, tool_pluginvisibility{{/str}}</li>
        <li>{{#str}}instructions_bullet3, tool_pluginvisibility{{/str}}</li>
    </ul>
</div>
